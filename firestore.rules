rules_version = '2';

// NOTE: this app has no real account login (members just pick a profile),
// so these rules cannot check "who" is writing - only "what" is being
// written. That's an accepted tradeoff for a private family app, but it
// does mean anyone with the Firebase config (e.g. pulled from the APK)
// could write to these collections directly. Fine for 3 trusted family
// members; revisit with Firebase Anonymous Auth if that ever changes.
service cloud.firestore {
  match /databases/{database}/documents {

    match /profiles/{profileId} {
      allow read: if true;
      allow write: if profileId in ['bunda', 'aku', 'adek']
        && request.resource.data.keys().hasOnly([
          'name', 'isAdmin', 'status', 'statusNote', 'statusUpdatedAt',
          'lastLatitude', 'lastLongitude', 'lastLocationAt',
          'locationSharingEnabled'
        ]);
    }

    match /calendar_events/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.ownerProfileId in ['bunda', 'aku', 'adek'];
      allow update, delete: if true;
    }

    match /job_templates/{jobId} {
      allow read: if true;
      allow write: if true;
    }

    match /job_assignments/{assignmentId} {
      allow read: if true;
      allow write: if request.resource.data.assignedProfileId in ['bunda', 'aku', 'adek'];
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if request.resource.data.authorProfileId in ['bunda', 'aku', 'adek'];
      allow update, delete: if true;
    }

    match /errand_items/{itemId} {
      allow read: if true;
      allow create: if request.resource.data.requestedByProfileId in ['bunda', 'aku', 'adek'];
      allow update, delete: if true;
    }
  }
}
